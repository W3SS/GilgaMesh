+        # A static MCP client has to name workspace and project together; one
+        # without the other is rejected, so send both or neither.
+        if workspace and project:
             payload["workspace"] = workspace
-        if project:
             payload["project"] = project
+        # ``memory_write_page`` is open to per-user keys; ``/admin/write-page`` is
+        # root-only on a server with users, so MCP goes first.
+        if not self._legacy_admin:
+            written = self._mcp_tool("memory_write_page", payload, WRITE_TIMEOUT)
+            if written is not None:
+                return written
+            log.info("ai-memory has no /mcp route; falling back to /admin/write-page")
+            self._legacy_admin = True
         r = self._request("POST", "/admin/write-page", json=payload, timeout=WRITE_TIMEOUT)
         r.raise_for_status()
         return r.json()
 
     def status(self) -> dict[str, Any]:
+        """Server health. Root gets ``/admin/status`` (version and counters).
+
+        A per-user key gets 403 there, so it falls back to the ``memory_status``
+        MCP tool, which proves the server and the token work and reports
+        ``access: "user"`` with the scope that answered.
+        """
         r = self._request("GET", "/admin/status", timeout=SEARCH_TIMEOUT)
+        if r.status_code == 403:
+            reply = self._mcp_tool("memory_status", {}, SEARCH_TIMEOUT) or {}
+            return {"ok": True, "access": "user", "scope": reply.get("scope")}
         r.raise_for_status()
         return r.json()
 
