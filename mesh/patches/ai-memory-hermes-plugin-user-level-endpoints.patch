         workspace, so a lone ``project=`` has no workspace to resolve
@@ -119,19 +137,85 @@ class AiMemoryClient:
         what the caller asked for. Passing neither searches globally,
         across every project — which is what cross-agent recall needs.
         """
+        if not self._legacy_admin:
+            arguments: dict[str, Any] = {"query": query, "limit": limit}
+            if workspace and project:
+                arguments["workspace"] = workspace
+                arguments["project"] = project
+            else:
+                arguments["global"] = True
+            found = self._mcp_tool("memory_query", arguments, SEARCH_TIMEOUT)
+            if found is not None:
+                hits = [*found.get("hits", []), *found.get("global_hits", [])]
+                return self._clean_hits(hits, limit)
+            log.info("ai-memory has no /mcp route; falling back to /admin/search")
+            self._legacy_admin = True
         params: dict[str, Any] = {"q": query, "limit": limit}
         if workspace and project:
             params["workspace"] = workspace
             params["project"] = project
         r = self._request("GET", "/admin/search", params=params, timeout=SEARCH_TIMEOUT)
+        return self._parse_search(r, limit)
+
+    @staticmethod
+    def _clean_hits(items: Any, limit: int) -> list[dict[str, Any]]:
+        if not isinstance(items, list):
+            log.warning("search response has unexpected type: %s", type(items).__name__)
+            return []
+        hits = [dict(item) for item in items if isinstance(item, dict)][:limit]
+        for hit in hits:
+            snippet = hit.get("snippet")
+            if isinstance(snippet, str):
+                hit["snippet"] = _MARK_RE.sub("", snippet)
+        return hits
+
+    @classmethod
+    def _parse_search(cls, r: httpx.Response, limit: int) -> list[dict[str, Any]]:
         r.raise_for_status()
         data = r.json()
         if isinstance(data, dict):
             data = data.get("results", data.get("pages", []))
-        if not isinstance(data, list):
-            log.warning("search response has unexpected type: %s", type(data).__name__)
-            return []
-        return [item for item in data if isinstance(item, dict)][:limit]
+        return cls._clean_hits(data, limit)
+
+    def _mcp_tool(
+        self, name: str, arguments: dict[str, Any], timeout: float
+    ) -> dict[str, Any] | None:
+        """Call an ai-memory MCP tool over its stateless HTTP endpoint.
+
+        Returns the tool's JSON result, or ``None`` when the server has no
+        ``/mcp`` route (404/405). A JSON-RPC error or an ``isError`` result raises
+        ``RuntimeError``; auth failures raise ``httpx.HTTPStatusError``.
+        """
+        body = {
+            "jsonrpc": "2.0",
+            "id": 1,
+            "method": "tools/call",
+            "params": {"name": name, "arguments": arguments},
+        }
+        r = self._request(
+            "POST", "/mcp", json=body, headers={"Accept": MCP_ACCEPT}, timeout=timeout
+        )
+        if r.status_code in (404, 405):
+            return None
+        r.raise_for_status()
+        envelope = r.json()
+        if not isinstance(envelope, dict):
+            raise RuntimeError(f"unexpected MCP response: {type(envelope).__name__}")
+        if envelope.get("error"):
+            raise RuntimeError(f"MCP error: {envelope['error']}")
+        result = envelope.get("result") or {}
+        text = "\n".join(
+            str(item.get("text", ""))
+            for item in result.get("content", [])
+            if isinstance(item, dict)
+        )
+        if result.get("isError"):
+            raise RuntimeError(f"{name} failed: {text[:300]}")
+        try:
+            parsed = json.loads(text)
+        except ValueError:
+            return {"text": text}
+        return parsed if isinstance(parsed, dict) else {"result": parsed}
 
     def write_page(
