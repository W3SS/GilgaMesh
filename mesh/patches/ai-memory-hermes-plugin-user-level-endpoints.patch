@@ -110,8 +124,12 @@ class AiMemoryClient:
     ) -> list[dict[str, Any]]:
         """Full-text search the ai-memory wiki.
 
-        ai-memory 1.28.1 exposes ``GET /admin/search?q=&limit=``; the
-        ``POST /api/v1/search`` this used to call does not exist and 404s.
+        Calls the ``memory_query`` MCP tool, which a per-user ``aim_`` key may use.
+        Once a server has users, every ``/admin/*`` route is root-only, so the old
+        ``GET /admin/search`` answered 403 to anything but the root token. (The
+        read-only ``/api/v1/search`` is not an option: it only exists when the
+        server runs with ``--enable-web``.) A server without ``/mcp`` falls back to
+        ``/admin/search``.
 
