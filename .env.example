# GLOBAL SETTINGS
PROJECT_NAME=prometheus-mesh
ENV=development

# PORTS
ORCHESTRATOR_PORT=8000
MEMORY_PORT=9001
SENTINEL_PORT=9000
QDRANT_PORT=6333
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# API KEYS (Change these!)
SENTINEL_API_KEY=prometheus-secure-key-change-me
MEMORY_API_KEY=prometheus-memory-key-change-me

# SERVICE URLS
OLLAMA_URL=http://ollama:11434
COMFYUI_URL=http://comfyui:8188
WHISPER_URL=http://whisper:9000
QDRANT_URL=http://qdrant:6333

# RESOURCE LIMITS
VRAM_LIMIT_OLLAMA=6000
VRAM_LIMIT_COMFYUY=8500
